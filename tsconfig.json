{
  "extends": ["@tsconfig/recommended/tsconfig", "@tsconfig/node20/tsconfig"],
  "compilerOptions": {
    "isolatedModules": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "types": ["jest", "node"],
    "paths": {
      "#marp-shiki-plugin": ["./src/plugins/shiki/index.ts"],
      "#marp-shiki": ["./src/internals/shiki.ts"],
      "#marp-shiki-theme": ["./src/internals/shiki-theme.ts"]
    }
  },
  "include": ["src", "test", "scripts"]
}
