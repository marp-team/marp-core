{
  "extends": ["@tsconfig/recommended/tsconfig", "@tsconfig/node20/tsconfig"],
  "compilerOptions": {
    "isolatedModules": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "types": ["jest", "node"],
    "paths": {
      "#marp-katex": ["./src/internals/katex.ts"],
      "#marp-mathjax": ["./src/internals/mathjax.ts"],
      "#marp-shiki": ["./src/internals/shiki.ts"],
      "#marp-mermaid": ["./src/internals/mermaid.ts"],
      "#marp-beautiful-mermaid": ["./src/internals/beautiful-mermaid.ts"]
    }
  },
  "include": ["src", "test", "scripts"]
}
